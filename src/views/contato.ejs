<%- include('./includes/HeaderIncludes') %>
<%- include('./includes/nav') %>
    <div class="container">
        <div class="row">
            <div class="col-lg-2"></div>

            
            <div class="col-lg-8 my-3">
                <h1 class="display text-center"> Crie um novo contato</h1>
                <p class="text-center lead">Adicione um novo contato nasua conta!</p>
                <%- include('./includes/messages'); %>

                <div class="row">
                    <div class="col text-center">
                        <h4>Entrar no sistema</h4>
                        <p>Preencha os campos abaixo para executar o login:</p>
                        <form action="contato/add" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="form-group mb-3">
                                <label  class="form-label">Nome</label>
                                <input type="text" class="form-control" name="nome">
                            </div>
                            <div class="form-group mb-3">
                                <label  class="form-label">Sobrenome</label>
                                <input type="text" class="form-control" name="sobrenome">
                            </div>
                            <div class="form-group mb-3">
                                <label  class="form-label">Telefone</label>
                                <input type="tel" class="form-control" name="telefone">
                            </div>
                            <div class="form-group mb-3">
                                <label  class="form-label">E-mail</label>
                                <input type="email" class="form-control" name="email">
                            </div>

                            <button type="submit" class="btn btn-primary">Adicionar</button>
                        </form>
                    </div>
                </div>
            </div>


            <div class="col-lg-2"></div>
        </div>
    </div>
   
    
<%- include('./includes/footerIncludes') %>
    
    